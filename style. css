/* =========================================
   JIBBS PORTFOLIO
   PROFESSIONAL DARK SYSTEM
========================================= */

:root {
    --bg: #080b12;
    --surface: #0d121b;
    --surface-soft: #111722;
    --surface-raised: #151c27;

    --text: #f5f7fa;
    --text-soft: #cbd3df;
    --muted: #929daf;
    --muted-light: #aeb7c7;

    --accent: #1687ff;
    --accent-hover: #0878ec;

    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);

    --container: 1200px;
}


/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 78px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
}

img {
    display: block;
    max-width: 100%;
}


/* =========================================
   HEADER
========================================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(8, 11, 18, 0.94);

    border-bottom: 1px solid var(--border);
}

.navbar {
    width: min(var(--container), 92%);
    min-height: 78px;

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;

    list-style: none;
}

.nav-links a {
    color: var(--muted-light);
    font-size: 0.92rem;

    transition: color 0.25s ease;
}

.nav-links a:hover {
    color: var(--text);
}

.nav-button {
    padding: 10px 17px;

    border: 1px solid rgba(22, 135, 255, 0.5);
    border-radius: 8px;

    color: var(--text);

    font-size: 0.9rem;
    font-weight: 700;

    transition:
        background 0.25s ease,
        border-color 0.25s ease;
}

.nav-button:hover {
    background: var(--accent);
    border-color: var(--accent);
}

.menu-button {
    display: none;

    padding: 4px;

    border: 0;
    background: transparent;

    color: var(--text);

    font-size: 1.8rem;

    cursor: pointer;
}


/* =========================================
   GENERAL SECTIONS
========================================= */

.section {
    width: min(var(--container), 92%);
    margin: auto;

    padding: 110px 0;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 55px;
}

.eyebrow {
    margin-bottom: 14px;

    color: var(--accent);

    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 2px;
}

.section-heading h2 {
    margin-bottom: 18px;

    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -1.5px;
}

.section-heading > p:last-child {
    max-width: 650px;

    color: var(--muted);

    font-size: 1rem;
}


/* =========================================
   HERO
========================================= */

.hero {
    width: min(var(--container), 92%);
    min-height: calc(100vh - 78px);

    margin: auto;

    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);

    align-items: center;

    gap: 70px;

    padding: 80px 0;
}

.hero-content {
    max-width: 760px;
}

.hero h1 {
    max-width: 760px;

    margin-bottom: 25px;

    font-size: clamp(3.4rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -4px;
}

.hero h1 span {
    display: block;
    color: var(--accent);
}

.hero h2 {
    max-width: 690px;

    margin-bottom: 22px;

    color: var(--text-soft);

    font-size: clamp(1.35rem, 3vw, 1.9rem);
    line-height: 1.3;
    font-weight: 600;
}

.hero-description {
    max-width: 650px;

    margin-bottom: 34px;

    color: var(--muted);

    font-size: 1.03rem;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
}

.btn {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 23px;

    border-radius: 8px;

    font-weight: 700;

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent);
    color: #ffffff;
}

.btn-primary:hover {
    background: var(--accent-hover);
}

.btn-secondary {
    border: 1px solid var(--border-strong);
    color: var(--text);
}

.btn-secondary:hover {
    border-color: var(--accent);
}


/* HERO IMAGE */

.hero-image {
    display: flex;
    justify-content: center;
}

.hero-image img {
    width: min(100%, 390px);
    height: 480px;

    object-fit: cover;

    border-radius: 18px;

    border: 1px solid var(--border);

    background: var(--surface-soft);
}


/* =========================================
   ABOUT
========================================= */

.about-content {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);

    gap: 70px;

    align-items: center;
}

.about-image img {
    width: 100%;
    max-width: 390px;
    height: 440px;

    object-fit: cover;

    border-radius: 18px;

    border: 1px solid var(--border);
}

.about-text {
    color: var(--muted-light);
}

.about-text p {
    margin-bottom: 20px;
}

.about-text h3 {
    margin: 32px 0 18px;

    color: var(--text);

    font-size: 1.1rem;
}

.focus-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 10px;

    list-style: none;
}

.focus-list li {
    padding: 13px 15px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 8px;

    color: var(--text-soft);

    font-size: 0.9rem;
}


/* =========================================
   SERVICES
========================================= */

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 16px;
}

.service-card {
    min-height: 290px;

    padding: 28px 24px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 14px;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        background 0.3s ease;
}

.service-card:hover {
    transform: translateY(-6px);

    background: var(--surface-raised);

    border-color: rgba(22, 135, 255, 0.4);
}

.service-icon {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 35px;

    border: 1px solid rgba(22, 135, 255, 0.3);
    border-radius: 8px;

    color: var(--accent);

    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1px;
}

.service-card h3 {
    margin-bottom: 12px;

    font-size: 1.18rem;
}

.service-card p {
    color: var(--muted);

    font-size: 0.92rem;
}


/* =========================================
   PROJECTS
========================================= */

.projects-section {
    padding-top: 90px;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.project-card {
    overflow: hidden;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 15px;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}

.project-card:hover {
    transform: translateY(-7px);

    border-color: rgba(22, 135, 255, 0.4);

    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.28);
}

.project-image {
    width: 100%;
    height: 270px;

    overflow: hidden;

    background: var(--surface-soft);
}

.project-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: top center;

    transition: transform 0.4s ease;
}

.project-card:hover .project-image img {
    transform: scale(1.025);
}

.project-content {
    padding: 25px;
}

.project-status {
    display: inline-block;

    margin-bottom: 11px;

    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 1px;
}

.project-status.completed {
    color: var(--accent);
}

.project-status.demo {
    color: #8f9aaa;
}

.project-content h3 {
    margin-bottom: 10px;

    font-size: 1.4rem;
}

.project-content p {
    min-height: 75px;

    margin-bottom: 19px;

    color: var(--muted);

    font-size: 0.91rem;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;

    margin-bottom: 20px;
}

.project-tags span {
    padding: 5px 8px;

    border: 1px solid var(--border);
    border-radius: 5px;

    color: var(--muted-light);

    font-size: 0.68rem;
}

.project-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    color: var(--accent);

    font-size: 0.88rem;
    font-weight: 700;
}

.project-link span {
    transition: transform 0.2s ease;
}

.project-link:hover span {
    transform: translateX(4px);
}


/* =========================================
   SKILLS
========================================= */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 12px;
}

.skill {
    padding: 20px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: 10px;

    transition:
        transform 0.25s ease,
        border-color 0.25s ease;
}

.skill:hover {
    transform: translateY(-3px);

    border-color: rgba(22, 135, 255, 0.35);
}

.skill span {
    display: block;

    margin-bottom: 4px;

    color: var(--text);

    font-weight: 700;
}

.skill small {
    color: var(--muted);

    font-size: 0.78rem;
}


/* LEARNING */

.learning-box {
    margin-top: 18px;
    padding: 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    background: rgba(22, 135, 255, 0.045);

    border: 1px solid rgba(22, 135, 255, 0.2);
    border-radius: 12px;
}

.learning-label {
    margin-bottom: 7px;

    color: var(--accent);

    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.learning-box h3 {
    margin-bottom: 4px;
}

.learning-box p {
    color: var(--muted);

    font-size: 0.9rem;
}

.learning-badge {
    flex-shrink: 0;

    padding: 7px 11px;

    border: 1px solid rgba(22, 135, 255, 0.25);
    border-radius: 20px;

    color: var(--accent);

    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.8px;
}


/* =========================================
   CONTACT
========================================= */

.contact-section {
    width: 100%;

    padding: 120px 20px;

    background: #0b1018;

    border-top: 1px solid var(--border);
}

.contact-content {
    width: min(760px, 92%);

    margin: auto;

    text-align: center;
}

.contact-content h2 {
    margin-bottom: 20px;

    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -2px;
}

.contact-content > p:not(.eyebrow) {
    max-width: 620px;

    margin: 0 auto 30px;

    color: var(--muted);
}

.contact-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;

    gap: 24px;

    margin-top: 28px;
}

.contact-links a {
    color: var(--muted-light);

    font-size: 0.9rem;

    transition: color 0.25s ease;
}

.contact-links a:hover {
    color: var(--accent);
}


/* =========================================
   FOOTER
========================================= */

.footer {
    width: min(var(--container), 92%);

    margin: auto;

    padding: 65px 0 25px;
}

.footer-main {
    display: grid;
    grid-template-columns: 1.6fr 0.7fr 0.7fr;

    gap: 60px;

    padding-bottom: 55px;
}

.footer-brand {
    max-width: 360px;
}

.footer-logo {
    display: inline-block;

    margin-bottom: 12px;

    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.footer-brand p {
    margin-bottom: 5px;

    color: var(--text-soft);

    font-size: 1rem;
    font-weight: 600;
}

.footer-brand > span {
    color: var(--muted);

    font-size: 0.85rem;
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 10px;
}

.footer-column h3 {
    margin-bottom: 8px;

    color: var(--text);

    font-size: 0.82rem;
    letter-spacing: 0.5px;
}

.footer-column a {
    color: var(--muted);

    font-size: 0.86rem;

    transition: color 0.25s ease;
}

.footer-column a:hover {
    color: var(--accent);
}

.footer-bottom {
    padding-top: 22px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    border-top: 1px solid var(--border);

    color: #717c8e;

    font-size: 0.78rem;
}

.footer-bottom a {
    color: var(--muted-light);

    transition: color 0.25s ease;
}

.footer-bottom a:hover {
    color: var(--accent);
}


/* =========================================
   REVEAL ANIMATION
========================================= */

.reveal {
    opacity: 0;

    transform: translateY(25px);

    transition:
        opacity 0.7s ease,
        transform 0.7s ease;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}


/* =========================================
   TYPING CURSOR
========================================= */

.cursor {
    color: var(--accent);

    animation: blink 0.8s infinite;
}

@keyframes blink {
    50% {
        opacity: 0;
    }
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1000px) {

    .hero {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero-content {
        margin: auto;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image {
        margin-top: 10px;
    }

    .about-content {
        grid-template-columns: 1fr;
    }

    .about-image {
        display: flex;
        justify-content: center;
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-main {
        grid-template-columns: 1.5fr 1fr 1fr;
    }
}


/* =========================================
   MOBILE NAVIGATION
========================================= */

@media (max-width: 850px) {

    .menu-button {
        display: block;
    }

    .nav-button {
        display: none;
    }

    .nav-links {
        position: absolute;

        top: 78px;
        left: 0;

        width: 100%;

        padding: 18px 4%;

        display: flex;
        flex-direction: column;
        align-items: stretch;

        gap: 3px;

        background: #0b1018;

        border-bottom: 1px solid var(--border);

        opacity: 0;
        visibility: hidden;

        transform: translateY(-8px);

        transition:
            opacity 0.25s ease,
            visibility 0.25s ease,
            transform 0.25s ease;
    }

    .nav-links.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .nav-links a {
        display: block;

        padding: 11px 12px;
    }

    .section {
        padding: 85px 0;
    }

    .hero {
        padding: 70px 0;
    }
}


/* =========================================
   SMALL PHONES
========================================= */

@media (max-width: 600px) {

    .navbar {
        min-height: 70px;
    }

    .nav-links {
        top: 70px;
    }

    .section {
        padding: 70px 0;
    }

    .hero {
        min-height: auto;
        padding: 65px 0;
    }

    .hero h1 {
        font-size: clamp(2.8rem, 14vw, 4.2rem);

        letter-spacing: -2.5px;
    }

    .hero h2 {
        font-size: 1.25rem;
    }

    .hero-description {
        font-size: 0.94rem;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    .hero-image img {
        height: 390px;
    }

    .about-image img {
        height: 390px;
    }

    .focus-list {
        grid-template-columns: 1fr;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .service-card {
        min-height: auto;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .project-image {
        height: 300px;
    }

    .project-content {
        padding: 22px;
    }

    .project-content p {
        min-height: auto;
    }

    .skills-grid {
        grid-template-columns: 1fr 1fr;
    }

    .learning-box {
        align-items: flex-start;
        flex-direction: column;
    }

    .contact-section {
        padding: 90px 20px;
    }

    .contact-content h2 {
        font-size: 2.5rem;
    }

    .footer {
        padding-top: 50px;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;

        gap: 40px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
    }
}


/* =========================================
   VERY SMALL PHONES
========================================= */

@media (max-width: 400px) {

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .hero-image img {
        height: 350px;
    }

    .about-image img {
        height: 350px;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
