/* =========================================
   JIBBS PORTFOLIO — FINAL STYLE
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #080b12;
    color: #f5f7fa;
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font: inherit;
}

img {
    max-width: 100%;
    display: block;
}


/* =========================================
   HEADER
========================================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(8, 11, 18, 0.9);
    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.navbar {
    width: min(1200px, 92%);
    min-height: 78px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 1px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;

    list-style: none;
}

.nav-links a {
    color: #aeb7c7;
    font-size: 0.95rem;

    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: #1687ff;
}

.nav-button {
    padding: 11px 18px;

    border: 1px solid rgba(22, 135, 255, 0.5);
    border-radius: 8px;

    transition: 0.3s ease;
}

.nav-button:hover {
    background: #1687ff;
}

.menu-button {
    display: none;

    background: transparent;
    border: none;

    color: #ffffff;
    font-size: 1.8rem;

    cursor: pointer;
}


/* =========================================
   GENERAL SECTIONS
========================================= */

.section {
    width: min(1200px, 92%);
    margin: auto;

    padding: 110px 0;
}

.section-heading {
    max-width: 720px;
    margin-bottom: 55px;
}

.eyebrow {
    color: #1687ff;

    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2px;

    margin-bottom: 15px;
}

.section-heading h2 {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    line-height: 1.1;

    margin-bottom: 18px;
}

.section-heading > p:last-child {
    color: #9da7b8;
}


/* =========================================
   HERO
========================================= */

.hero {
    width: min(1200px, 92%);
    min-height: calc(100vh - 78px);

    margin: auto;

    display: grid;
    grid-template-columns: 1.15fr 0.85fr;

    align-items: center;

    gap: 70px;

    padding: 80px 0;
}

.hero-content {
    max-width: 720px;
}

.hero h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);

    line-height: 0.98;
    letter-spacing: -3px;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #1687ff;
}

.hero h2 {
    max-width: 700px;

    color: #dbe1eb;

    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.3;

    margin-bottom: 22px;
}

.hero-description {
    max-width: 650px;

    color: #929daf;

    font-size: 1.05rem;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.btn {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 24px;

    border-radius: 8px;

    font-weight: 700;

    transition: 0.3s ease;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-primary {
    background: #1687ff;
    color: #ffffff;
}

.btn-primary:hover {
    background: #0878ec;
}

.btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.18);
}

.btn-secondary:hover {
    border-color: #1687ff;
}

.hero-image {
    display: flex;
    justify-content: center;
}

.image-placeholder {
    width: 330px;
    height: 400px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(22, 135, 255, 0.35);
    border-radius: 20px;

    background: #111722;

    color: #667286;
}


/* =========================================
   ABOUT
========================================= */

.about-content {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;

    gap: 70px;

    align-items: center;
}

.about-image .image-placeholder {
    width: 100%;
    max-width: 380px;
    height: 420px;
}

.about-text {
    color: #aab3c2;
}

.about-text p {
    margin-bottom: 20px;
}

.about-text h3 {
    color: #ffffff;

    margin: 30px 0 18px;
}

.focus-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 12px;

    list-style: none;
}

.focus-list li {
    padding: 12px 15px;

    background: #0d121b;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}


/* =========================================
   SERVICES
========================================= */

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.service-card {
    padding: 30px 24px;

    background: #0d121b;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;

    transition: 0.3s ease;
}

.service-card:hover {
    transform: translateY(-8px);

    border-color: rgba(22, 135, 255, 0.45);

    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
}

.service-number {
    display: inline-block;

    color: #1687ff;

    font-size: 0.8rem;
    font-weight: 800;

    margin-bottom: 25px;
}

.service-card h3 {
    font-size: 1.25rem;

    margin-bottom: 12px;
}

.service-card p {
    color: #929daf;

    font-size: 0.95rem;
}


/* =========================================
   PROJECTS
========================================= */

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 22px;
}

.project-card {
    overflow: hidden;

    background: #0d121b;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;

    transition: 0.3s ease;
}

.project-card:hover {
    transform: translateY(-8px);

    border-color: rgba(22, 135, 255, 0.45);

    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
}


/* PROJECT SCREENSHOT */

.project-image {
    width: 100%;
    height: 280px;

    overflow: hidden;

    display: flex;
    align-items: flex-start;
    justify-content: center;

    background: #111722;
}

.project-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: top center;

    transition: transform 0.4s ease;
}

.project-card:hover .project-image img {
    transform: scale(1.03);
}


/* PROJECT INFORMATION */

.project-content {
    padding: 25px;
}

.project-status {
    display: inline-block;

    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1px;

    margin-bottom: 12px;
}

.project-status.completed {
    color: #1687ff;
}

.project-status.demo {
    color: #8c98aa;
}

.project-content h3 {
    font-size: 1.45rem;

    margin-bottom: 10px;
}

.project-content p {
    color: #929daf;

    font-size: 0.94rem;

    margin-bottom: 20px;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 7px;

    margin-bottom: 20px;
}

.project-tags span {
    padding: 6px 9px;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;

    color: #aeb7c7;

    font-size: 0.72rem;
}

.project-link {
    color: #1687ff;

    font-size: 0.9rem;
    font-weight: 700;
}

.project-link:hover {
    text-decoration: underline;
}


/* =========================================
   SKILLS
========================================= */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 15px;
}

.skill {
    padding: 18px;

    background: #0d121b;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;

    text-align: center;

    font-weight: 700;

    transition: 0.3s ease;
}

.skill:hover {
    transform: translateY(-4px);

    border-color: rgba(22, 135, 255, 0.45);
}

.learning-box {
    margin-top: 25px;

    padding: 25px;

    background: rgba(22, 135, 255, 0.05);

    border: 1px solid rgba(22, 135, 255, 0.25);
    border-radius: 14px;
}

.learning-box h3 {
    margin-bottom: 15px;
}

.learning-skills span {
    display: inline-block;

    padding: 8px 14px;

    background: rgba(22, 135, 255, 0.12);

    border-radius: 20px;

    color: #1687ff;

    font-weight: 700;
}


/* =========================================
   CONTACT
========================================= */

.contact-section {
    width: 100%;

    padding: 120px 20px;

    background: #0b1018;

    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.contact-content {
    width: min(800px, 92%);

    margin: auto;

    text-align: center;
}

.contact-content h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);

    line-height: 1.05;

    margin-bottom: 20px;
}

.contact-content > p:not(.eyebrow) {
    color: #929daf;

    margin-bottom: 30px;
}

.contact-links {
    display: flex;

    justify-content: center;
    flex-wrap: wrap;

    gap: 20px;

    margin-top: 30px;
}

.contact-links a {
    color: #aeb7c7;

    transition: 0.3s ease;
}

.contact-links a:hover {
    color: #1687ff;
}


/* =========================================
   FOOTER
========================================= */

.footer {
    width: min(1200px, 92%);

    margin: auto;

    padding: 35px 0;

    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 20px;

    color: #717c8e;

    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.footer h3 {
    color: #ffffff;

    margin-bottom: 3px;
}

.footer p {
    font-size: 0.85rem;
}


/* =========================================
   REVEAL ANIMATION
========================================= */

.reveal {
    opacity: 0;

    transform: translateY(30px);

    transition:
        opacity 0.7s ease,
        transform 0.7s ease;
}

.reveal.show {
    opacity: 1;

    transform: translateY(0);
}


/* =========================================
   TYPING CURSOR
========================================= */

.cursor {
    color: #1687ff;

    animation: blink 0.8s infinite;
}

@keyframes blink {
    50% {
        opacity: 0;
    }
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1000px) {

    .hero {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero-content {
        margin: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image {
        margin-top: 20px;
    }

    .about-content {
        grid-template-columns: 1fr;
    }

    .about-image {
        display: flex;
        justify-content: center;
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 850px) {

    .menu-button {
        display: block;
    }

    .nav-button {
        display: none;
    }

    .nav-links {
        position: absolute;

        top: 78px;
        left: 0;

        width: 100%;

        padding: 20px;

        flex-direction: column;
        align-items: stretch;

        gap: 5px;

        background: #0b1018;

        border-bottom: 1px solid rgba(255, 255, 255, 0.08);

        opacity: 0;
        visibility: hidden;

        transform: translateY(-10px);

        transition: 0.25s ease;
    }

    .nav-links.active {
        opacity: 1;
        visibility: visible;

        transform: translateY(0);
    }

    .nav-links a {
        display: block;

        padding: 12px;
    }

    .section {
        padding: 85px 0;
    }

    .hero {
        padding: 70px 0;
    }
}


/* =========================================
   SMALL PHONES
========================================= */

@media (max-width: 480px) {

    .navbar {
        min-height: 70px;
    }

    .nav-links {
        top: 70px;
    }

    .section {
        padding: 70px 0;
    }

    .hero {
        min-height: auto;

        padding: 65px 0;
    }

    .hero h1 {
        font-size: clamp(2.7rem, 14vw, 4rem);

        letter-spacing: -2px;
    }

    .hero h2 {
        font-size: 1.3rem;
    }

    .hero-description {
        font-size: 0.95rem;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    .image-placeholder {
        width: 100%;
        height: 360px;
    }

    .focus-list {
        grid-template-columns: 1fr;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .project-image {
        height: 320px;
    }

    .project-content {
        padding: 22px;
    }

    .skills-grid {
        grid-template-columns: 1fr 1fr;
    }

    .contact-section {
        padding: 90px 20px;
    }

    .footer {
        flex-direction: column;

        text-align: center;
    }
}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
.hero-image img,
.about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.hero-image img {
    border-radius: 24px;
}

.about-image img {
    border-radius: 20px;
}
